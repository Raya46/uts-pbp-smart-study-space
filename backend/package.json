{
  "name": "smart-study-space-backend",
  "version": "1.0.0",
  "description": "Backend for Smart Study Space App",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node prisma/seed.js",
    "test": "jest --forceExit --detectOpenHandles",
    "prisma:push": "npx prisma db push",
    "prisma:generate": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "prisma": "^6.5.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "forceExit": true,
    "detectOpenHandles": true,
    "testPathIgnorePatterns": ["/node_modules/", "/__tests__/setup\\.js"]
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2"
  }
}
