<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:padding="4dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_dark_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/stepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginEnd="8dp"
                android:background="@color/progress_inactive" />

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@color/progress_active" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="serif"
            android:text="@string/title_register_2"
            android:textColor="@color/text_dark_green"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/subtitle_register_2"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <ImageView
                android:id="@+id/imgAvatarPlaceholder"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:padding="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:cardBackgroundColor="@color/badge_edit"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/bg_cream"
                app:layout_constraintBottom_toBottomOf="@id/imgAvatarPlaceholder"
                app:layout_constraintEnd_toEndOf="@id/imgAvatarPlaceholder"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintVertical_bias="1.0">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    app:tint="@color/bg_cream" /> </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tvUploadLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/upload_avatar"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutAvatar" />

        <LinearLayout
            android:id="@+id/formLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvUploadLabel">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_university"
                android:textColor="@color/text_label"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUniversity"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:focusable="false"
                android:clickable="true"
                android:text="UPN Veteran Jakarta"
                android:textColor="@color/text_dark_green"
                android:textSize="16sp" /> <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="24dp"
            android:background="@color/input_underline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_faculty_major"
                android:textColor="@color/text_label"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etMajor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="e.g. Computer Science"
                android:inputType="text"
                android:textColorHint="@color/progress_inactive"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="24dp"
                android:background="@color/input_underline" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_student_id"
                    android:textColor="@color/text_label"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="@string/label_optional"
                    android:textColor="@color/progress_inactive"
                    android:textSize="10sp" />
            </RelativeLayout>

            <EditText
                android:id="@+id/etStudentId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="ID Number"
                android:inputType="number"
                android:textColorHint="@color/progress_inactive"
                android:textSize="16sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="32dp"
                android:background="@color/input_underline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/label_study_preferences"
                android:textColor="@color/text_label"
                android:textSize="10sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupPreferences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCafe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Café"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/chip_bg_state"
                    android:textColor="@color/chip_text_state"
                    app:chipStrokeColor="@color/chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Library"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/chip_bg_state"
                    android:textColor="@color/chip_text_state"
                    app:chipStrokeColor="@color/chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCoworking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coworking"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/chip_bg_state"
                    android:textColor="@color/chip_text_state"
                    app:chipStrokeColor="@color/chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuiet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiet Zone"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/chip_bg_state"
                    android:textColor="@color/chip_text_state"
                    app:chipStrokeColor="@color/chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWifi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High Speed WiFi"
                    android:checkable="true"
                    app:chipBackgroundColor="@color/chip_bg_state"
                    android:textColor="@color/chip_text_state"
                    app:chipStrokeColor="@color/chip_stroke"
                    app:chipStrokeWidth="1dp"
                    app:checkedIconVisible="false" />

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueStep2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="40dp"
            android:text="@string/btn_continue"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/text_dark_green"
            app:cornerRadius="30dp"
            app:layout_constraintTop_toBottomOf="@+id/formLayout" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/step_2_footer"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnContinueStep2" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>