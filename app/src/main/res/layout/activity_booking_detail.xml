<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="30dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Detail Bookings"
                android:textColor="@color/text_muted_green"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- BOOKING ID -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Booking ID :"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvBookingId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/text_dark_green"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="1" />

        </LinearLayout>


        <!-- NAME + STATUS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSpotName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_dark_green"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Central Library" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_orange"
                android:paddingHorizontal="18dp"
                android:paddingVertical="6dp"
                android:textColor="@color/text_dark_green"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Upcoming" />

        </LinearLayout>


        <!-- DATE + TIME -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_calendar" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_muted"
                    android:textSize="16sp"
                    tools:text="Apr 18, 2026" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_clock" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/text_muted"
                    android:textSize="16sp"
                    tools:text="13:00 - 15:00" />

            </LinearLayout>

        </LinearLayout>


        <!-- SEATS -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSeats"
                android:layout_width="54dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_avatar_placeholder"
                android:gravity="center"
                android:textColor="@color/text_dark_green"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="Seats"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />

        </LinearLayout>


        <!-- QR CARD -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="QR Code"
                    android:scaleType="fitCenter"
                    android:src="@drawable/qr_dummy" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- WARNING -->

        <TextView
            android:id="@+id/tvWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Please check in within 15 minutes of your start time to keep your spot."
            android:textColor="@color/text_muted"
            android:textSize="15sp" />


        <!-- CANCEL -->


        <!-- END RESERVATION -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelBooking"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="34dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#B00020"
            android:textSize="18sp"
            app:backgroundTint="#FBEDED"
            app:cornerRadius="30dp"
            app:strokeColor="#E7A5A5"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEndReservation"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:text="End Reservation"
            android:textAllCaps="false"
            android:textColor="@color/text_dark_green"
            android:textSize="18sp"
            android:visibility="gone"
            app:backgroundTint="@android:color/white"
            app:cornerRadius="30dp"
            app:strokeColor="@color/text_dark_green"
            app:strokeWidth="1dp" />


        <Space
            android:layout_width="match_parent"
            android:layout_height="40dp" />

    </LinearLayout>

</ScrollView>