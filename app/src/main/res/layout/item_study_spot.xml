<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/ivSpotImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@color/text_muted_green"
                android:contentDescription="@string/desc_spot_image" />

            <TextView
                android:id="@+id/tvTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_margin="12dp"
                android:background="@drawable/bg_tag_orange"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/text_dark_green"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Quiet" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvRatingAndCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:textColor="@color/text_dark_green"
                    android:textStyle="bold"
                    app:drawableStartCompat="@android:drawable/btn_star_big_on"
                    app:drawableTint="@color/badge_edit"
                    tools:text="4.8 (124)" />

                <TextView
                    android:id="@+id/tvSpotName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/tvRatingAndCount"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/text_dark_green"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Central Library" />

            </RelativeLayout>

            <TextView
                android:id="@+id/tvCategoryDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_muted"
                tools:text="Library • 0.5 km" />

            <TextView
                android:id="@+id/tvAvailability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:textColor="@color/text_muted"
                android:drawablePadding="8dp"
                app:drawableStartCompat="@drawable/bg_dot_green"
                tools:text="15/50 seats available" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgFeatures"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp">
                <!-- Chips will be added programmatically or via adapter -->
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReserve"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/bg_dark_green"
                android:text="@string/btn_reserve"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
