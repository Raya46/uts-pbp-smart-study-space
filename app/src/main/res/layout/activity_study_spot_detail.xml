<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <ImageView
                    android:id="@+id/ivDetailImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@color/text_muted_green"
                    android:contentDescription="@string/desc_spot_image" />

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="16dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    app:tint="@color/text_dark_green"
                    android:contentDescription="@string/skip" />

                <TextView
                    android:id="@+id/tvDetailTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|top"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_tag_orange"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_dark_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Moderate" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvDetailName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/tvDetailRating"
                        android:textColor="@color/text_dark_green"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="Kampus Café" />

                    <TextView
                        android:id="@+id/tvDetailRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_dark_green"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@android:drawable/btn_star_big_on"
                        app:drawableTint="@color/badge_edit"
                        tools:text="4.6" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvDetailCategoryDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_muted"
                    tools:text="Café • 0.8 km" />

                <!-- Reserve/Detail Tab -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_tab_container"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabReserve"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_item_selected"
                        android:gravity="center"
                        android:text="@string/tab_reserve"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tabDetail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/tab_detail"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <!-- Reserve Content -->
                <LinearLayout
                    android:id="@+id/llReserveContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/llDateSelector"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp">
                        <TextView
                            android:id="@+id/tvTimeSlotLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/cvDuration"
                            android:text="@string/label_time_slot"
                            android:textColor="@color/text_dark_green"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            app:cardBackgroundColor="#F5F2EC"
                            app:cardCornerRadius="12dp"
                            app:strokeWidth="0dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="@string/label_duration_1h"
                                android:textColor="@color/text_dark_green" />
                        </com.google.android.material.card.MaterialCardView>
                    </RelativeLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:columnCount="2"
                        android:useDefaultMargins="true">

                        <TextView
                            android:id="@+id/time1"
                            android:layout_width="0dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_item_selected"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:text="@string/time_slot_1"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/time2"
                            android:layout_width="0dp"
                            android:layout_columnWeight="1"
                            android:background="@drawable/bg_tab_container"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:text="@string/time_slot_3"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/time3"
                            android:layout_width="0dp"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_tab_container"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:text="@string/time_slot_2"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/time4"
                            android:layout_width="0dp"
                            android:layout_columnWeight="1"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_tab_container"
                            android:gravity="center"
                            android:paddingVertical="12dp"
                            android:text="@string/time_slot_4"
                            android:textColor="@color/text_muted" />
                    </GridLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="32dp"
                        android:text="@string/label_seats_needed"
                        android:textColor="@color/text_dark_green"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_tab_container"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp">
                        <TextView
                            android:id="@+id/btnMinus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/symbol_minus"
                            android:textColor="@color/text_dark_green"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tvSeatCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:text="@string/default_seats"
                            android:textColor="@color/text_dark_green"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/btnPlus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/symbol_plus"
                            android:textColor="@color/text_dark_green"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Detail Content -->
                <LinearLayout
                    android:id="@+id/llDetailContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/label_address"
                        android:textColor="@color/text_dark_green"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/sample_address"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:text="@string/view_in_google_maps"
                        android:textColor="@color/text_dark_green"
                        android:textStyle="bold"
                        app:drawableEndCompat="@android:drawable/ic_menu_directions"
                        app:drawableTint="@color/text_dark_green"
                        android:drawablePadding="8dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="24dp"
                        app:strokeWidth="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/img_3"
                            android:contentDescription="@string/view_map" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReserveNowDetail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="24dp"
        android:backgroundTint="@color/bg_dark_green"
        android:text="@string/btn_reserve_now"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:cornerRadius="28dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
